# Server Configuration
PORT=5000

# ZKTeco MB2000 Device Configuration
ZK_IP=192.168.1.147
ZK_PORT=4370
ZK_TIMEOUT=10000
ZK_IN_PORT=5200

# Edara HR server configuration store (contains API keys).
# Point this to a directory OUTSIDE the Git checkout that only the app user can read/write,
# e.g. C:\ProgramData\ZK-Integration. Defaults to backend/data (git-ignored).
EDARA_DATA_DIR=

# Optional: seeds the "Primary Edara HR Cloud" destination ONLY when no
# edaraServers.json exists yet. Never hardcode these in source.
EDARA_API_URL=
EDARA_API_KEY=
